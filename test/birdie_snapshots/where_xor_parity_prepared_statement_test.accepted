#(
  PreparedStatement(
    "$",
    "SELECT * FROM cats WHERE ((CASE WHEN (name = $1) THEN 1 ELSE 0 END + CASE WHEN (is_wild IS TRUE) THEN 1 ELSE 0 END + CASE WHEN (age <= $2) THEN 1 ELSE 0 END) % 2) = 1",
    [StringParam("Karl"), IntParam(9)],
    2,
    Postgres,
  ),
  PreparedStatement(
    "?",
    "SELECT * FROM cats WHERE ((CASE WHEN (name = ?1) THEN 1 ELSE 0 END + CASE WHEN (is_wild IS TRUE) THEN 1 ELSE 0 END + CASE WHEN (age <= ?2) THEN 1 ELSE 0 END) % 2) = 1",
    [StringParam("Karl"), IntParam(9)],
    2,
    Sqlite,
  ),
  PreparedStatement(
    "?",
    "SELECT * FROM cats WHERE (name = ? XOR is_wild IS TRUE XOR age <= ?)",
    [StringParam("Karl"), IntParam(9)],
    2,
    Maria,
  ),
  PreparedStatement(
    "?",
    "SELECT * FROM cats WHERE (name = ? XOR is_wild IS TRUE XOR age <= ?)",
    [StringParam("Karl"), IntParam(9)],
    2,
    Mysql,
  ),
)
