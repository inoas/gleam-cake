---
version: 2.0.0
title: insert_on_constraint_conflict_update_prepared_statement_test
---
#(
  PreparedStatement(
    "$",
    "INSERT INTO counters (name, counter) VALUES ($1, $2) ON CONFLICT (counters_name_key) DO UPDATE SET counter = counters.counter + 1 WHERE counters.is_active IS TRUE",
    [
      StringParam("Whiskers"),
      IntParam(1),
    ],
    2,
    Postgres,
  ),
  PreparedStatement(
    "?",
    "INSERT INTO counters (name, counter) VALUES (?1, ?2) ON CONFLICT (counters_name_key) DO UPDATE SET counter = counters.counter + 1 WHERE counters.is_active IS TRUE",
    [
      StringParam("Whiskers"),
      IntParam(1),
    ],
    2,
    Sqlite,
  ),
)
