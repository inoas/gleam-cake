  SelectAll,
  Selects([
    SelectColumn("name"),
    SelectColumn("age"),
  ]),
  FromTable("cats"),
  NoJoins,
  NoWhere,
  NoGroupBy,
  NoWhere,
  NoOrderBy,
  NoLimit,
  NoOffset,
  Epilog(" FOR UPDATE"),
  NoComment,
))
