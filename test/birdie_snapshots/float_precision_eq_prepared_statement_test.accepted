---
version: 2.0.0
title: float_precision_eq_prepared_statement_test
file: ./test/adapter_tests/float_precision_test.gleam
test_name: float_precision_eq_prepared_statement_test
---
#(
  PreparedStatement(
    "$",
    "SELECT name, rating FROM cats WHERE rating = $1 ORDER BY name ASC",
    [FloatParam(1.1)],
    1,
    Postgres,
  ),
  PreparedStatement(
    "?",
    "SELECT name, rating FROM cats WHERE rating = ?1 ORDER BY name ASC",
    [FloatParam(1.1)],
    1,
    Sqlite,
  ),
  PreparedStatement(
    "?",
    "SELECT name, rating FROM cats WHERE rating = ? ORDER BY name ASC",
    [FloatParam(1.1)],
    1,
    Maria,
  ),
  PreparedStatement(
    "?",
    "SELECT name, rating FROM cats WHERE rating = ? ORDER BY name ASC",
    [FloatParam(1.1)],
    1,
    Mysql,
  ),
)
